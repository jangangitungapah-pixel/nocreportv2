{
  "name": "nocreportv2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "node scripts/build-production.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:firebase:emulator": "node scripts/test-firebase-emulator.mjs",
    "test:integration": "npm run test:firebase:emulator",
    "release:preflight": "node scripts/t8-release-preflight.mjs",
    "release:smoke:public": "node scripts/t8-production-smoke.mjs",
    "release:finalize:t8": "node scripts/finalize-t8.mjs",
    "firebase:deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules --project nocreportv2",
    "firebase:deploy:indexes": "npx --yes firebase-tools deploy --only firestore:indexes --project nocreportv2",
    "firebase:deploy:firestore": "npx --yes firebase-tools deploy --only firestore:rules,firestore:indexes --project nocreportv2",
    "firebase:deploy:hosting": "npm run release:preflight && npm run build:production && npx --yes firebase-tools deploy --only hosting --project nocreportv2",
    "firebase:deploy:release": "npm run release:preflight && npm run build:production && npx --yes firebase-tools deploy --only firestore:rules,firestore:indexes,hosting --project nocreportv2",
    "quality": "npm run format:check && npm run lint && npm test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "12.18.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
